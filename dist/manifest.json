{
  "manifest_version": 3,
  "name": "Apex Chess",
  "short_name": "Apex",
  "version": "2.1.0",
  "description": "Tactical Real-time Engine Analysis & Stealth Assistant for Chess.com",
  "icons": {
    "16": "img/logo-16.png",
    "48": "img/logo-48.png",
    "128": "img/logo-128.png"
  },
  "content_scripts": [
    {
      "js": [
        "js/loader.js"
      ],
      "css": [
        "css/depthbar.css",
        "css/evalbar.css",
        "css/material-icon.css"
      ],
      "matches": [
        "https://www.chess.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "html/options.html",
    "default_icon": {
      "16": "img/logo-16.png",
      "48": "img/logo-48.png",
      "128": "img/logo-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "js/chessmint.js",
        "js/stockfish.js",
        "eco.json"
      ],
      "matches": [
        "https://www.chess.com/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.chess.com/*"
  ]
}